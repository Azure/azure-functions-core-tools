<Project>
  <UsingTask TaskName="WriteBundledTemplatesJson" AssemblyFile="$(BaseOutputPath)../Workloads.Sdk/$(Configuration.ToLowerInvariant())/Azure.Functions.Cli.Workloads.Sdk.dll" TaskFactory="TaskHostFactory" />
  <PropertyGroup>
    <BundledTemplatesProject Condition="'$(BundledTemplatesProject)' == ''">$(MSBuildProjectDirectory)/NativeTemplates/Workloads.Node.Templates.csproj</BundledTemplatesProject>
    <BundledTemplatesPackageId Condition="'$(BundledTemplatesPackageId)' == ''">Azure.Functions.Templates.Node.Basic</BundledTemplatesPackageId>
    <BundledTemplatesPackagePath Condition="'$(BundledTemplatesPackagePath)' == ''">templates/node-basic.nupkg</BundledTemplatesPackagePath>
    <PackWorkloadDependsOn>$(PackWorkloadDependsOn);_PackBundledTemplates</PackWorkloadDependsOn>
  </PropertyGroup>
  <Target Name="_PackBundledTemplates" DependsOnTargets="_SetWorkloadProperties" Condition="'$(WorkloadKind)' == 'workload'">
    <PropertyGroup>
      <BundledTemplatesArchiveFileName Condition="'$(BundledTemplatesArchiveFileName)' == ''">$(BundledTemplatesPackageId).$(PackageVersion).nupkg</BundledTemplatesArchiveFileName>
      <_BundledTemplatesOutput>$(IntermediateOutputPath)bundled-templates/</_BundledTemplatesOutput>
      <_BundledTemplatesArchive>$(_BundledTemplatesOutput)$(BundledTemplatesArchiveFileName)</_BundledTemplatesArchive>
      <_BundledTemplatesPackagePath>$(_WorkloadPackageContentRoot)$(BundledTemplatesPackagePath)</_BundledTemplatesPackagePath>
      <_BundledTemplatesManifest>$(IntermediateOutputPath)bundled-templates.json</_BundledTemplatesManifest>
    </PropertyGroup>
    <Delete Files="$(_BundledTemplatesArchive);$(_BundledTemplatesManifest)" />
    <MSBuild Projects="$(BundledTemplatesProject)"
      Targets="Pack" Properties="Configuration=$(Configuration);PackageOutputPath=$([System.IO.Path]::GetFullPath('$(_BundledTemplatesOutput)'));PackageVersion=$(PackageVersion)" />
    <Error Condition="!Exists('$(_BundledTemplatesArchive)')"
      Text="Bundled templates project '$(BundledTemplatesProject)' did not produce '$(BundledTemplatesArchiveFileName)'. Check BundledTemplatesPackageId and BundledTemplatesArchiveFileName." />
    <WriteBundledTemplatesJson Archive="$(_BundledTemplatesArchive)" ArchivePath="$(_BundledTemplatesPackagePath)"
      OutputPath="$(_BundledTemplatesManifest)" />
    <ItemGroup>
      <TfmSpecificPackageFile Include="$(_BundledTemplatesArchive)" PackagePath="$(_BundledTemplatesPackagePath)" />
      <TfmSpecificPackageFile Include="$(_BundledTemplatesManifest)" PackagePath="bundled-templates.json" />
    </ItemGroup>
  </Target>
  <Target Name="_PackBundledNodeTemplates" DependsOnTargets="_PackBundledTemplates" />
</Project>
