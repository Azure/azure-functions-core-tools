<Project>

  <PropertyGroup>
    <TelemetryConnectionString Condition="'$(TelemetryConnectionString)' == ''">$(TELEMETRY_CONNECTION_STRING)</TelemetryConnectionString>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyAttribute Include="Azure.Functions.Cli.Common.TelemetryConnectionStringAttribute">
      <_Parameter1>$(TelemetryConnectionString)</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
