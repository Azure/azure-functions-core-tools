<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <Title>Go</Title>
    <Description>Azure Functions CLI tooling for Go projects.</Description>
    <PackAsWorkload>true</PackAsWorkload>
    <WorkloadKind>workload</WorkloadKind>
    <StackIdentifier>go</StackIdentifier>
    <WorkerRuntime>native</WorkerRuntime>
    <WorkloadTemplateRoot>content/templates</WorkloadTemplateRoot>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Azure.Functions.Cli.Workloads.Go.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="$(SrcRoot)Abstractions/Abstractions.csproj" />
    <ProjectReference Include="$(SrcRoot)Workloads/Templates/Go/Workloads.Templates.Go.csproj"
                      ReferenceOutputAssembly="false"
                      TargetPathPrefix="$(WorkloadTemplateRoot)"
                      Pack="true" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Templates/**" />
  </ItemGroup>

</Project>
