      "choices": [
        { "choice": "7.2" },
        { "choice": "7.4" },
        { "choice": "7.6" }
      ]
    }
  },
  "sources": [
    {
      "source": "Shared",
      "target": "",
      "modifiers": [
        {
          "rename": {
            "dockerignore.template": ".dockerignore"
          }
        }
      ]
    },
    {
      "source": "Versions/7.2",
      "target": "",
      "condition": "(RuntimeVersion == \"7.2\")",
      "modifiers": [
        {
          "rename": {
            "Dockerfile.template": "Dockerfile"
          }
        }
      ]
    },
    {
      "source": "Versions/7.4",
      "target": "",
      "condition": "(RuntimeVersion == \"7.4\")",
      "modifiers": [
        {
          "rename": {
            "Dockerfile.template": "Dockerfile"
          }
        }
      ]
    },
    {
      "source": "Versions/7.6",
      "target": "",
      "condition": "(RuntimeVersion == \"7.6\")",
      "modifiers": [
        {
          "rename": {
            "Dockerfile.template": "Dockerfile"
          }
        }
      ]
    }
  ]
}
