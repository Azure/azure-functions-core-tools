<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <Title>PowerShell Stack</Title>
    <Description>Azure Functions CLI tooling for PowerShell projects.</Description>
    <PackAsWorkload>true</PackAsWorkload>
    <WorkloadKind>workload</WorkloadKind>
    <WorkloadAlias>powershell</WorkloadAlias>
    <WorkloadTemplateRoot>content/templates</WorkloadTemplateRoot>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Azure.Functions.Cli.Workloads.PowerShell.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="$(SrcRoot)Abstractions/Abstractions.csproj" />
    <ProjectReference Include="$(SrcRoot)Workloads/Templates/PowerShell/Workloads.Templates.PowerShell.csproj"
                      ReferenceOutputAssembly="false"
                      TargetPathPrefix="$(WorkloadTemplateRoot)"
                      Pack="true" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Templates/**" />
  </ItemGroup>

</Project>
