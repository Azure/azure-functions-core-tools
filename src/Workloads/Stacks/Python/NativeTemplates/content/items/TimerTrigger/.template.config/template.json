{
  "$schema": "http://json.schemastore.org/template",
  "author": "kashimiz",
  "constraints": {
    "bindings": {
      "args": [],
      "type": "func-bundle-bindings"
    },
    "bundle": {
      "args": [
        {
          "id": "Microsoft.Azure.Functions.ExtensionBundle",
          "version": "[4.0.0,)"
        },
        {
          "id": "Microsoft.Azure.Functions.ExtensionBundle.Preview",
          "version": "[4.0.0,)"
        },
        {
          "id": "Microsoft.Azure.Functions.ExtensionBundle.Experimental",
          "version": "[4.0.0,)"
        }
      ],
      "type": "func-bundle"
    },
    "host": {
      "args": [
        {
          "hostname": "func"
        }
      ],
      "type": "host"
    },
    "stack": {
      "args": "python",
      "type": "func-workload"
    }
  },
  "defaultName": "timer_trigger",
  "description": "A function that will be run on a specified schedule",
  "forms": {
    "pythonCharacters": {
      "identifier": "replace",
      "pattern": "[^A-Za-z0-9_]",
      "replacement": "_"
    },
    "pythonIdentifier": {
      "identifier": "chain",
      "steps": [
        "pythonCharacters",
        "pythonLeadingDigit"
      ]
    },
    "pythonLeadingDigit": {
      "identifier": "replace",
      "pattern": "^(?=[0-9])",
      "replacement": "_"
    }
  },
  "groupIdentity": "Azure.Functions.Python.TimerTrigger",
  "identity": "Azure.Functions.Python.TimerTrigger",
  "name": "Timer Trigger",
  "preferNameDirectory": false,
  "shortName": [
    "TimerTrigger-Python"
  ],
  "symbols": {
    "FunctionIdentifier": {
      "replaces": "__FUNCTION_NAME__",
      "type": "derived",
      "valueSource": "name",
      "valueTransform": "pythonIdentifier"
    },
    "timerTrigger-schedule": {
      "datatype": "string",
      "defaultValue": "0 */5 * * * *",
      "description": "Schedule",
      "isRequired": false,
      "replaces": "$(SCHEDULE_INPUT)",
      "type": "parameter"
    }
  },
  "tags": {
    "language": "Python",
    "type": "item"
  }
}
