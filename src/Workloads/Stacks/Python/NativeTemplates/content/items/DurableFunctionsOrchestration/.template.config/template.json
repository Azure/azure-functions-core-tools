{
  "$schema": "http://json.schemastore.org/template",
  "author": "Andy Staples(andystaples)",
  "constraints": {
    "bindings": {
      "args": [
        "durableclient",
        "orchestrationtrigger",
        "activitytrigger"
      ],
      "type": "func-bundle-bindings"
    },
    "bundle": {
      "args": [
        {
          "id": "Microsoft.Azure.Functions.ExtensionBundle",
          "version": "[4.0.0,)"
        },
        {
          "id": "Microsoft.Azure.Functions.ExtensionBundle.Preview",
          "version": "[4.0.0,)"
        },
        {
          "id": "Microsoft.Azure.Functions.ExtensionBundle.Experimental",
          "version": "[4.0.0,)"
        }
      ],
      "type": "func-bundle"
    },
    "host": {
      "args": [
        {
          "hostname": "func"
        }
      ],
      "type": "host"
    },
    "stack": {
      "args": "python",
      "type": "func-workload"
    }
  },
  "defaultName": "hello_orchestration",
  "description": "A set of functions composing a Durable orchestration.",
  "forms": {
    "pythonCharacters": {
      "identifier": "replace",
      "pattern": "[^A-Za-z0-9_]",
      "replacement": "_"
    },
    "pythonIdentifier": {
      "identifier": "chain",
      "steps": [
        "pythonCharacters",
        "pythonLeadingDigit"
      ]
    },
    "pythonLeadingDigit": {
      "identifier": "replace",
      "pattern": "^(?=[0-9])",
      "replacement": "_"
    }
  },
  "groupIdentity": "Azure.Functions.Python.DurableFunctionsOrchestration",
  "identity": "Azure.Functions.Python.DurableFunctionsOrchestration",
  "name": "Durable Functions Orchestration",
  "preferNameDirectory": false,
  "shortName": [
    "DurableFunctionsOrchestration-Python"
  ],
  "symbols": {
    "app-selectedFileName": {
      "datatype": "string",
      "defaultValue": "function_app.py",
      "description": "File Name",
      "isRequired": false,
      "type": "parameter"
    },
    "FunctionIdentifier": {
      "replaces": "__FUNCTION_NAME__",
      "type": "derived",
      "valueSource": "name",
      "valueTransform": "pythonIdentifier"
    }
  },
  "tags": {
    "language": "Python",
    "type": "item"
  }
}
