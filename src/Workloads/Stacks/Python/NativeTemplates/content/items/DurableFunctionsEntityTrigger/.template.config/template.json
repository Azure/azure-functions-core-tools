{
  "$schema": "http://json.schemastore.org/template",
  "author": "Andy Staples(andystaples)",
  "constraints": {
    "bindings": {
      "args": [
        "entitytrigger"
      ],
      "type": "func-bundle-bindings"
    },
    "bundle": {
      "args": [
        {
          "id": "Microsoft.Azure.Functions.ExtensionBundle",
          "version": "[4.0.0,)"
        },
        {
          "id": "Microsoft.Azure.Functions.ExtensionBundle.Preview",
          "version": "[4.0.0,)"
        },
        {
          "id": "Microsoft.Azure.Functions.ExtensionBundle.Experimental",
          "version": "[4.0.0,)"
        }
      ],
      "type": "func-bundle"
    },
    "host": {
      "args": [
        {
          "hostname": "func"
        }
      ],
      "type": "host"
    },
    "stack": {
      "args": "python",
      "type": "func-workload"
    }
  },
  "defaultName": "entity_function",
  "description": "A function that manages the state of an entity in Durable Functions.",
  "forms": {
    "pythonCharacters": {
      "identifier": "replace",
      "pattern": "[^A-Za-z0-9_]",
      "replacement": "_"
    },
    "pythonIdentifier": {
      "identifier": "chain",
      "steps": [
        "pythonCharacters",
        "pythonLeadingDigit"
      ]
    },
    "pythonLeadingDigit": {
      "identifier": "replace",
      "pattern": "^(?=[0-9])",
      "replacement": "_"
    }
  },
  "groupIdentity": "Azure.Functions.Python.DurableFunctionsEntityTrigger",
  "identity": "Azure.Functions.Python.DurableFunctionsEntityTrigger",
  "name": "Durable Functions Entity Trigger",
  "preferNameDirectory": false,
  "shortName": [
    "DurableFunctionsEntityTrigger-Python"
  ],
  "symbols": {
    "FunctionIdentifier": {
      "replaces": "__FUNCTION_NAME__",
      "type": "derived",
      "valueSource": "name",
      "valueTransform": "pythonIdentifier"
    }
  },
  "tags": {
    "language": "Python",
    "type": "item"
  }
}
