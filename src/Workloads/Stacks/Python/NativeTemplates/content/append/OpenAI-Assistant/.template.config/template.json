{
  "$schema": "http://json.schemastore.org/template",
  "author": "Gavin Aguiar",
  "constraints": {
    "bindings": {
      "args": [
        "AssistantSkillTrigger",
        "AssistantCreate",
        "AssistantPost"
      ],
      "type": "func-bundle-bindings"
    },
    "bundle": {
      "args": [
        {
          "id": "Microsoft.Azure.Functions.ExtensionBundle.Preview",
          "version": "[4.0.0,)"
        },
        {
          "id": "Microsoft.Azure.Functions.ExtensionBundle.Experimental",
          "version": "[4.0.0,)"
        }
      ],
      "type": "func-bundle"
    },
    "host": {
      "args": [
        {
          "hostname": "func"
        }
      ],
      "type": "host"
    },
    "stack": {
      "args": "python",
      "type": "func-workload"
    }
  },
  "defaultName": "OpenAI-Assistant-Python",
  "description": "Template to add an assistant to your project",
  "forms": {
    "pythonCharacters": {
      "identifier": "replace",
      "pattern": "[^A-Za-z0-9_]",
      "replacement": "_"
    },
    "pythonIdentifier": {
      "identifier": "chain",
      "steps": [
        "pythonCharacters",
        "pythonLeadingDigit"
      ]
    },
    "pythonLeadingDigit": {
      "identifier": "replace",
      "pattern": "^(?=[0-9])",
      "replacement": "_"
    }
  },
  "groupIdentity": "Azure.Functions.Python.OpenAI-Assistant.Append",
  "identity": "Azure.Functions.Python.OpenAI-Assistant.Append",
  "name": "OpenAI Assistant Trigger",
  "preferNameDirectory": false,
  "primaryOutputs": [
    {
      "path": "function_body.py"
    }
  ],
  "shortName": [
    "__python-append-OpenAI-Assistant"
  ],
  "symbols": {
    "chat-model-name": {
      "datatype": "string",
      "defaultValue": "gpt-3.5-turbo",
      "description": "Chat model name",
      "isRequired": true,
      "replaces": "$(CHAT_MODEL_NAME)",
      "type": "parameter"
    },
    "FunctionIdentifier": {
      "replaces": "__FUNCTION_NAME__",
      "type": "derived",
      "valueSource": "name",
      "valueTransform": "pythonIdentifier"
    }
  },
  "tags": {
    "func-role": "python-append-helper",
    "language": "Python",
    "type": "item"
  }
}
