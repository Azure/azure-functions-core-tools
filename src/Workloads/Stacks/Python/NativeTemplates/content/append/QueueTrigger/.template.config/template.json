{
  "$schema": "http://json.schemastore.org/template",
  "author": "Gavin Aguiar",
  "constraints": {
    "bindings": {
      "args": [
        "queuetrigger"
      ],
      "type": "func-bundle-bindings"
    },
    "bundle": {
      "args": [
        {
          "id": "Microsoft.Azure.Functions.ExtensionBundle",
          "version": "[4.0.0,)"
        },
        {
          "id": "Microsoft.Azure.Functions.ExtensionBundle.Preview",
          "version": "[4.0.0,)"
        },
        {
          "id": "Microsoft.Azure.Functions.ExtensionBundle.Experimental",
          "version": "[4.0.0,)"
        }
      ],
      "type": "func-bundle"
    },
    "host": {
      "args": [
        {
          "hostname": "func"
        }
      ],
      "type": "host"
    },
    "stack": {
      "args": "python",
      "type": "func-workload"
    }
  },
  "defaultName": "queue_trigger",
  "description": "A function that will be run whenever a message is added to a specified Azure Storage queue",
  "forms": {
    "pythonCharacters": {
      "identifier": "replace",
      "pattern": "[^A-Za-z0-9_]",
      "replacement": "_"
    },
    "pythonIdentifier": {
      "identifier": "chain",
      "steps": [
        "pythonCharacters",
        "pythonLeadingDigit"
      ]
    },
    "pythonLeadingDigit": {
      "identifier": "replace",
      "pattern": "^(?=[0-9])",
      "replacement": "_"
    }
  },
  "groupIdentity": "Azure.Functions.Python.QueueTrigger.Append",
  "identity": "Azure.Functions.Python.QueueTrigger.Append",
  "name": "Queue trigger",
  "preferNameDirectory": false,
  "primaryOutputs": [
    {
      "path": "function_body.py"
    }
  ],
  "shortName": [
    "__python-append-QueueTrigger"
  ],
  "symbols": {
    "app-fileName": {
      "datatype": "string",
      "defaultValue": "function_app.py",
      "description": "Provide a filename for your function",
      "fileRename": "function_app.py",
      "isRequired": false,
      "type": "parameter"
    },
    "app-selectedFileName": {
      "datatype": "string",
      "defaultValue": "function_app.py",
      "description": "File Name",
      "isRequired": false,
      "type": "parameter"
    },
    "FunctionIdentifier": {
      "replaces": "__FUNCTION_NAME__",
      "type": "derived",
      "valueSource": "name",
      "valueTransform": "pythonIdentifier"
    },
    "queueTrigger-connection": {
      "datatype": "string",
      "defaultValue": "QueueConnectionString",
      "description": "Storage account connection",
      "isRequired": true,
      "replaces": "$(CONNECTION_STRING_INPUT)",
      "type": "parameter"
    },
    "queueTrigger-queueName": {
      "datatype": "string",
      "defaultValue": "queuename",
      "description": "Queue name",
      "isRequired": true,
      "replaces": "$(QUEUE_NAME_INPUT)",
      "type": "parameter"
    }
  },
  "tags": {
    "func-role": "python-append-helper",
    "language": "Python",
    "type": "item"
  }
}
