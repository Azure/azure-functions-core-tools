{
  "$schema": "http://json.schemastore.org/template",
  "author": "Gavin Aguiar",
  "constraints": {
    "bindings": {
      "args": [
        "servicebustrigger"
      ],
      "type": "func-bundle-bindings"
    },
    "bundle": {
      "args": [
        {
          "id": "Microsoft.Azure.Functions.ExtensionBundle",
          "version": "[4.0.0,)"
        },
        {
          "id": "Microsoft.Azure.Functions.ExtensionBundle.Preview",
          "version": "[4.0.0,)"
        },
        {
          "id": "Microsoft.Azure.Functions.ExtensionBundle.Experimental",
          "version": "[4.0.0,)"
        }
      ],
      "type": "func-bundle"
    },
    "host": {
      "args": [
        {
          "hostname": "func"
        }
      ],
      "type": "host"
    },
    "stack": {
      "args": "python",
      "type": "func-workload"
    }
  },
  "defaultName": "servicebus_topic_trigger",
  "description": "A function that will be run whenever a message is added to the specified Service Bus topic",
  "forms": {
    "pythonCharacters": {
      "identifier": "replace",
      "pattern": "[^A-Za-z0-9_]",
      "replacement": "_"
    },
    "pythonIdentifier": {
      "identifier": "chain",
      "steps": [
        "pythonCharacters",
        "pythonLeadingDigit"
      ]
    },
    "pythonLeadingDigit": {
      "identifier": "replace",
      "pattern": "^(?=[0-9])",
      "replacement": "_"
    }
  },
  "groupIdentity": "Azure.Functions.Python.ServiceBusTopicTrigger.Append",
  "identity": "Azure.Functions.Python.ServiceBusTopicTrigger.Append",
  "name": "ServiceBus Topic trigger",
  "preferNameDirectory": false,
  "primaryOutputs": [
    {
      "path": "function_body.py"
    }
  ],
  "shortName": [
    "__python-append-ServiceBusTopicTrigger"
  ],
  "symbols": {
    "FunctionIdentifier": {
      "replaces": "__FUNCTION_NAME__",
      "type": "derived",
      "valueSource": "name",
      "valueTransform": "pythonIdentifier"
    },
    "serviceBusTrigger-connection": {
      "datatype": "string",
      "defaultValue": "ServiceBusConnectionString",
      "description": "Service Bus connection",
      "isRequired": true,
      "replaces": "$(CONNECTION_STRING_INPUT)",
      "type": "parameter"
    },
    "serviceBusTrigger-subscriptionName": {
      "datatype": "string",
      "defaultValue": "servicebussubscriptionName",
      "description": "Subscription name",
      "isRequired": true,
      "replaces": "$(SERVICEBUS_SUBSCRIPTION_NAME_INPUT)",
      "type": "parameter"
    },
    "serviceBusTrigger-topicName": {
      "datatype": "string",
      "defaultValue": "servicebustopicname",
      "description": "Topic name",
      "isRequired": true,
      "replaces": "$(SERVICEBUS_NAME_INPUT)",
      "type": "parameter"
    }
  },
  "tags": {
    "func-role": "python-append-helper",
    "language": "Python",
    "type": "item"
  }
}
