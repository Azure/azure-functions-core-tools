{
  "$schema": "http://json.schemastore.org/template",
  "author": "Gavin Aguiar",
  "constraints": {
    "bindings": {
      "args": [
        "EmbeddingsStore",
        "SemanticSearch"
      ],
      "type": "func-bundle-bindings"
    },
    "bundle": {
      "args": [
        {
          "id": "Microsoft.Azure.Functions.ExtensionBundle.Preview",
          "version": "[4.0.0,)"
        },
        {
          "id": "Microsoft.Azure.Functions.ExtensionBundle.Experimental",
          "version": "[4.0.0,)"
        }
      ],
      "type": "func-bundle"
    },
    "host": {
      "args": [
        {
          "hostname": "func"
        }
      ],
      "type": "host"
    },
    "stack": {
      "args": "python",
      "type": "func-workload"
    }
  },
  "defaultName": "OpenAI-RAG-Python",
  "description": "Template for RAG binding function",
  "forms": {
    "pythonCharacters": {
      "identifier": "replace",
      "pattern": "[^A-Za-z0-9_]",
      "replacement": "_"
    },
    "pythonIdentifier": {
      "identifier": "chain",
      "steps": [
        "pythonCharacters",
        "pythonLeadingDigit"
      ]
    },
    "pythonLeadingDigit": {
      "identifier": "replace",
      "pattern": "^(?=[0-9])",
      "replacement": "_"
    }
  },
  "groupIdentity": "Azure.Functions.Python.OpenAI-RAG.Append",
  "identity": "Azure.Functions.Python.OpenAI-RAG.Append",
  "name": "OpenAI RAG Binding",
  "preferNameDirectory": false,
  "primaryOutputs": [
    {
      "path": "function_body.py"
    }
  ],
  "shortName": [
    "__python-append-OpenAI-RAG"
  ],
  "symbols": {
    "app-fileName": {
      "datatype": "string",
      "defaultValue": "function_app.py",
      "description": "Provide a filename for your function",
      "fileRename": "function_app.py",
      "isRequired": false,
      "type": "parameter"
    },
    "chat-model-name": {
      "datatype": "string",
      "defaultValue": "gpt-3.5-turbo",
      "description": "Chat model name",
      "isRequired": true,
      "replaces": "$(CHAT_MODEL_NAME)",
      "type": "parameter"
    },
    "embedding-model-name": {
      "datatype": "string",
      "defaultValue": "text-embedding-ada-002",
      "description": "$embeddings_model_name_label",
      "isRequired": true,
      "replaces": "$(EMBEDDING_MODEL_NAME)",
      "type": "parameter"
    },
    "FunctionIdentifier": {
      "replaces": "__FUNCTION_NAME__",
      "type": "derived",
      "valueSource": "name",
      "valueTransform": "pythonIdentifier"
    },
    "httpTrigger-authLevel": {
      "choices": [
        {
          "choice": "FUNCTION"
        },
        {
          "choice": "ANONYMOUS"
        },
        {
          "choice": "ADMIN"
        }
      ],
      "datatype": "choice",
      "defaultValue": "FUNCTION",
      "description": "Authorization level",
      "isRequired": true,
      "replaces": "$(AUTHLEVEL_INPUT)",
      "type": "parameter"
    },
    "rag-collection-name": {
      "datatype": "string",
      "defaultValue": "openai-index",
      "description": "Collection name for RAG function",
      "isRequired": true,
      "replaces": "$(COLLECTION_NAME)",
      "type": "parameter"
    },
    "rag-connection": {
      "datatype": "string",
      "defaultValue": "SearchConnectionSetting",
      "description": "Connection string for RAG storage",
      "isRequired": true,
      "replaces": "$(CONNECTION_STRING_INPUT)",
      "type": "parameter"
    }
  },
  "tags": {
    "func-role": "python-append-helper",
    "language": "Python",
    "type": "item"
  }
}
