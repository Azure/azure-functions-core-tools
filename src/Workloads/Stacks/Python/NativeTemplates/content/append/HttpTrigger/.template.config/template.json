{
  "$schema": "http://json.schemastore.org/template",
  "author": "Naren Soni",
  "constraints": {
    "bindings": {
      "args": [],
      "type": "func-bundle-bindings"
    },
    "bundle": {
      "args": [
        {
          "id": "Microsoft.Azure.Functions.ExtensionBundle",
          "version": "[4.0.0,)"
        },
        {
          "id": "Microsoft.Azure.Functions.ExtensionBundle.Preview",
          "version": "[4.0.0,)"
        },
        {
          "id": "Microsoft.Azure.Functions.ExtensionBundle.Experimental",
          "version": "[4.0.0,)"
        }
      ],
      "type": "func-bundle"
    },
    "host": {
      "args": [
        {
          "hostname": "func"
        }
      ],
      "type": "host"
    },
    "stack": {
      "args": "python",
      "type": "func-workload"
    }
  },
  "defaultName": "http_trigger",
  "description": "A function that will be run whenever it receives an HTTP request, responding based on data in the body or query string",
  "forms": {
    "pythonCharacters": {
      "identifier": "replace",
      "pattern": "[^A-Za-z0-9_]",
      "replacement": "_"
    },
    "pythonIdentifier": {
      "identifier": "chain",
      "steps": [
        "pythonCharacters",
        "pythonLeadingDigit"
      ]
    },
    "pythonLeadingDigit": {
      "identifier": "replace",
      "pattern": "^(?=[0-9])",
      "replacement": "_"
    }
  },
  "groupIdentity": "Azure.Functions.Python.HttpTrigger.Append",
  "identity": "Azure.Functions.Python.HttpTrigger.Append",
  "name": "HTTP trigger",
  "preferNameDirectory": false,
  "primaryOutputs": [
    {
      "path": "function_body.py"
    }
  ],
  "shortName": [
    "__python-append-HttpTrigger"
  ],
  "symbols": {
    "FunctionIdentifier": {
      "replaces": "__FUNCTION_NAME__",
      "type": "derived",
      "valueSource": "name",
      "valueTransform": "pythonIdentifier"
    },
    "httpTrigger-authLevel": {
      "choices": [
        {
          "choice": "FUNCTION"
        },
        {
          "choice": "ANONYMOUS"
        },
        {
          "choice": "ADMIN"
        }
      ],
      "datatype": "choice",
      "defaultValue": "FUNCTION",
      "description": "Authorization level",
      "isRequired": true,
      "replaces": "$(AUTHLEVEL_INPUT)",
      "type": "parameter"
    }
  },
  "tags": {
    "func-role": "python-append-helper",
    "language": "Python",
    "type": "item"
  }
}
