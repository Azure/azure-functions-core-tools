<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>true</IsPackable>
    <PackageId>Azure.Functions.Templates.Python</PackageId>
    <PackageType>FuncTemplate</PackageType>
    <NoDefaultExcludes>true</NoDefaultExcludes>
    <Description>Azure Functions CLI Python v2 project and item template sources.</Description>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup>
    <Content Include="content/**" Pack="true" PackagePath="content/%(RecursiveDir)%(Filename)%(Extension)" />
    <Content Include="source/**" Exclude="source/applications.json" Pack="true" PackagePath="source/%(RecursiveDir)%(Filename)%(Extension)" />
    <Content Include="snippets/**" Pack="true"
      PackagePath="snippets/%(RecursiveDir)%(Filename)%(Extension);content/append/%(RecursiveDir)%(Filename)%(Extension)" />
    <Content Include="$(RepoRoot)LICENSE" Pack="true" PackagePath="/" />
    <Content Include="README.md" Pack="true" PackagePath="/" />
    <Content Include="../Templates/function_app.py;../Templates/requirements.txt;../Templates/getting_started.md;../Templates/local.settings.json"
      Pack="true" PackagePath="content/project/" />
  </ItemGroup>
  <Target Name="StageNativePythonIgnoreFile" BeforeTargets="_GetPackageFiles">
    <Copy SourceFiles="../Templates/gitignore" DestinationFiles="$(IntermediateOutputPath)native/.gitignore" />
    <ItemGroup>
      <Content Include="$(IntermediateOutputPath)native/.gitignore" Pack="true" PackagePath="content/project/" />
    </ItemGroup>
  </Target>
  <Target Name="StageNativePythonApplicationMap" BeforeTargets="_GetPackageFiles">
    <ItemGroup>
      <_PythonProjectSource Include="content/project/.template.config/template.json" PackagePath="content/project/.template.config/template.json" />
      <_PythonProjectSource Include="content/project/.template.config/func.host.json" PackagePath="content/project/.template.config/func.host.json" />
      <_PythonProjectSource Include="content/project/host.json" PackagePath="content/project/host.json" />
      <_PythonProjectSource Include="../Templates/function_app.py" PackagePath="content/project/function_app.py" />
      <_PythonProjectSource Include="../Templates/requirements.txt" PackagePath="content/project/requirements.txt" />
      <_PythonProjectSource Include="../Templates/getting_started.md" PackagePath="content/project/getting_started.md" />
      <_PythonProjectSource Include="../Templates/local.settings.json" PackagePath="content/project/local.settings.json" />
      <_PythonProjectSource Include="../Templates/gitignore" PackagePath="content/project/.gitignore" />
    </ItemGroup>
    <GetFileHash Files="@(_PythonProjectSource)" Algorithm="SHA256">
      <Output TaskParameter="Items" ItemName="_PythonHashedProjectSource" />
    </GetFileHash>
    <PropertyGroup>
      <_PythonProjectDescriptors>@(_PythonHashedProjectSource->'{ &quot;path&quot;: &quot;%(PackagePath)&quot;, &quot;sha256&quot;: &quot;%(FileHash)&quot; }', ',')</_PythonProjectDescriptors>
      <_PythonApplicationMap>$([System.IO.File]::ReadAllText('$(MSBuildProjectDirectory)/source/applications.json'))</_PythonApplicationMap>
      <_PythonApplicationMap>$(_PythonApplicationMap.Replace('__PACKAGE_VERSION__', '$(PackageVersion)'))</_PythonApplicationMap>
      <_PythonApplicationMap>$(_PythonApplicationMap.Replace('&quot;__PROJECT_SOURCES__&quot;', '[$(_PythonProjectDescriptors)]'))</_PythonApplicationMap>
    </PropertyGroup>
    <MakeDir Directories="$(IntermediateOutputPath)native" />
    <WriteLinesToFile File="$(IntermediateOutputPath)native/applications.json" Lines="$(_PythonApplicationMap)"
      Overwrite="true" />
    <ItemGroup>
      <Content Include="$(IntermediateOutputPath)native/applications.json" Pack="true" PackagePath="source/applications.json" />
    </ItemGroup>
  </Target>
</Project>
