<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <Title>Python</Title>
    <Description>Azure Functions CLI tooling for Python projects.</Description>
    <PackAsWorkload>true</PackAsWorkload>
    <WorkloadKind>workload</WorkloadKind>
    <StackIdentifier>python</StackIdentifier>
    <WorkloadTemplateRoot>content/templates</WorkloadTemplateRoot>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Azure.Functions.Cli.Workloads.Python.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="$(SrcRoot)Abstractions/Abstractions.csproj" />
    <ProjectReference Include="$(SrcRoot)Workloads/Templates/Python/Workloads.Templates.Python.csproj"
                      ReferenceOutputAssembly="false"
                      TargetPathPrefix="$(WorkloadTemplateRoot)"
                      Pack="true" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Templates/**" />
  </ItemGroup>

</Project>
