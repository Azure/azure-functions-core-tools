<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Title>Node.js Stack</Title>
    <Description>Azure Functions CLI tooling for Node.js projects.</Description>
    <PackAsWorkload>true</PackAsWorkload>
    <WorkloadKind>workload</WorkloadKind>
    <WorkloadAlias>node</WorkloadAlias>
    <NoDefaultExcludes>true</NoDefaultExcludes>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Azure.Functions.Cli.Workloads.Node.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="$(SrcRoot)Abstractions/Abstractions.csproj" />
    <ProjectReference Include="NativeTemplates/Workloads.Node.Templates.csproj" ReferenceOutputAssembly="false" Private="false" />
    <Compile Remove="NativeTemplates/**" />
    <EmbeddedResource Remove="NativeTemplates/**" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Templates/**" />
  </ItemGroup>

  <Import Project="$(EngBuildRoot)Workloads/Workload.BundledTemplates.targets" />

</Project>
