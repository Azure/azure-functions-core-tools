{
  "$schema": "http://json.schemastore.org/template",
  "author": "Microsoft",
  "identity": "Azure.Functions.Cli.Node.TypeScript.FlexByoc",
  "name": "Node.js TypeScript Flex BYOC container artifacts",
  "shortName": "flex-byoc",
  "precedence": 100,
  "tags": {
    "type": "artifact",
    "language": "TypeScript",
    "func-capability": "flex-byoc",
    "func-stack": "node"
  },
  "symbols": {
    "RuntimeVersion": {
      "type": "parameter",
      "datatype": "choice",
      "defaultValue": "26",
      "replaces": "{{RUNTIME_VERSION}}",
      "choices": [
        { "choice": "18" },
        { "choice": "20" },
        { "choice": "22" },
        { "choice": "24" },
        { "choice": "26" }
      ]
    }
  },
  "sources": [
    {
      "modifiers": [
        {
          "rename": {
            "Dockerfile.template": "Dockerfile",
            "dockerignore.template": ".dockerignore"
          }
        }
      ]
    }
  ]
}
