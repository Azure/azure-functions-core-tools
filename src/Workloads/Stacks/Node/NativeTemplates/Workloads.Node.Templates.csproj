<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>true</IsPackable>
    <PackageId>Azure.Functions.Templates.Node.Basic</PackageId>
    <PackageType>FuncTemplate</PackageType>
    <NoDefaultExcludes>true</NoDefaultExcludes>
    <Description>Azure Functions CLI basic Node.js v4 project and HTTP item templates.</Description>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup>
    <Content Include="content/**" Pack="true" PackagePath="content/%(RecursiveDir)%(Filename)%(Extension)" />
    <Content Include="$(RepoRoot)LICENSE" Pack="true" PackagePath="/" />
    <Content Include="README.md" Pack="true" PackagePath="/" />
    <Content Include="../Templates/package-js.json" Pack="true" PackagePath="content/project-js/package.json" />
    <Content Include="../Templates/package-ts.json" Pack="true" PackagePath="content/project-ts/package.json" />
    <Content Include="../Templates/tsconfig.json" Pack="true" PackagePath="content/project-ts/tsconfig.json" />
    <Content Include="../Templates/local.settings.json" Pack="true" PackagePath="content/project-js/local.settings.json;content/project-ts/local.settings.json" />
  </ItemGroup>
  <Target Name="StageNativeIgnoreFiles" BeforeTargets="_GetPackageFiles">
    <Copy SourceFiles="../Templates/funcignore;../Templates/gitignore"
      DestinationFiles="$(IntermediateOutputPath)native/.funcignore;$(IntermediateOutputPath)native/.gitignore" />
    <ItemGroup>
      <Content Include="$(IntermediateOutputPath)native/.funcignore;$(IntermediateOutputPath)native/.gitignore"
        Pack="true" PackagePath="content/project-js/;content/project-ts/" />
    </ItemGroup>
  </Target>
</Project>
