<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>true</IsPackable>
    <PackageId>Azure.Functions.Templates.Node.Basic</PackageId>
    <PackageType>FuncTemplate</PackageType>
    <NoDefaultExcludes>true</NoDefaultExcludes>
    <Description>Azure Functions CLI Node.js v4 project and JavaScript/TypeScript item templates.</Description>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup>
    <Content Include="content/**" Pack="true" PackagePath="content/%(RecursiveDir)%(Filename)%(Extension)" />
    <Content Include="$(RepoRoot)LICENSE" Pack="true" PackagePath="/" />
    <Content Include="README.md" Pack="true" PackagePath="/" />
    <Content Include="../Templates/package-js.json" Pack="true" PackagePath="content/project-js/package.json" />
    <Content Include="../Templates/package-ts.json" Pack="true" PackagePath="content/project-ts/package.json" />
    <Content Include="../Templates/tsconfig.json" Pack="true" PackagePath="content/project-ts/tsconfig.json" />
    <Content Include="../Templates/local.settings.json" Pack="true" PackagePath="content/project-js/local.settings.json;content/project-ts/local.settings.json" />
  </ItemGroup>
  <Target Name="StageNativeIgnoreFiles" BeforeTargets="_GetPackageFiles">
    <Copy SourceFiles="../Templates/funcignore;../Templates/gitignore"
      DestinationFiles="$(IntermediateOutputPath)native/.funcignore;$(IntermediateOutputPath)native/.gitignore" />
    <ItemGroup>
      <Content Include="$(IntermediateOutputPath)native/.funcignore;$(IntermediateOutputPath)native/.gitignore"
        Pack="true" PackagePath="content/project-js/;content/project-ts/" />
    </ItemGroup>
  </Target>
  <Target Name="StageNativeNodeItems" BeforeTargets="_GetPackageFiles">
    <PropertyGroup>
      <_NodeItemSource>$(MSBuildProjectDirectory)/../../../Templates/Node/content/v2/</_NodeItemSource>
      <_NodeItemOutput>$(IntermediateOutputPath)native-items/</_NodeItemOutput>
      <_NodeProvenanceOutput>$(IntermediateOutputPath)native-provenance/</_NodeProvenanceOutput>
    </PropertyGroup>
    <RemoveDir Directories="$(_NodeItemOutput)" />
    <RemoveDir Directories="$(_NodeProvenanceOutput)" />
    <Exec Command="pwsh -NoProfile -File &quot;$(MSBuildProjectDirectory)/Convert-NodeItemTemplates.ps1&quot; -SourceDirectory &quot;$(_NodeItemSource)&quot; -OutputDirectory &quot;$(_NodeItemOutput)&quot; -ProvenanceDirectory &quot;$(_NodeProvenanceOutput)&quot; -PackageId &quot;$(PackageId)&quot; -PackageVersion &quot;$(PackageVersion)&quot;" />
    <ItemGroup>
      <_NodeItem Include="$(_NodeItemOutput)**/*">
        <Pack>true</Pack>
        <PackagePath>content/items/%(RecursiveDir)%(Filename)%(Extension)</PackagePath>
      </_NodeItem>
      <Content Include="@(_NodeItem)" />
      <_NodeProvenance Include="$(_NodeProvenanceOutput)**/*">
        <Pack>true</Pack>
        <PackagePath>provenance/node/%(RecursiveDir)%(Filename)%(Extension)</PackagePath>
      </_NodeProvenance>
      <Content Include="@(_NodeProvenance)" />
    </ItemGroup>
  </Target>
</Project>
