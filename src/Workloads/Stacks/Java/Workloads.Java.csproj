<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Title>Java Stack</Title>
    <Description>Azure Functions CLI tooling for Java projects.</Description>
    <PackAsWorkload>true</PackAsWorkload>
    <WorkloadKind>workload</WorkloadKind>
    <WorkloadAlias>java</WorkloadAlias>
    <NoDefaultExcludes>true</NoDefaultExcludes>
    <BundledTemplatesProject>$(MSBuildProjectDirectory)/NativeTemplates/Workloads.Java.Templates.csproj</BundledTemplatesProject>
    <BundledTemplatesPackageId>Azure.Functions.Templates.Java.Basic</BundledTemplatesPackageId>
    <BundledTemplatesPackagePath>templates/java-basic.nupkg</BundledTemplatesPackagePath>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Azure.Functions.Cli.Workloads.Java.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="$(SrcRoot)Abstractions/Abstractions.csproj" />
    <ProjectReference Include="NativeTemplates/Workloads.Java.Templates.csproj" ReferenceOutputAssembly="false" Private="false" />
    <Compile Remove="NativeTemplates/**" />
    <EmbeddedResource Remove="NativeTemplates/**" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Templates/**" />
  </ItemGroup>

  <Import Project="$(EngBuildRoot)Workloads/Workload.BundledTemplates.targets" />

</Project>
