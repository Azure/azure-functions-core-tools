<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>true</IsPackable>
    <PackageId>Azure.Functions.Templates.Java.Basic</PackageId>
    <PackageType>FuncTemplate</PackageType>
    <NoDefaultExcludes>true</NoDefaultExcludes>
    <Description>Azure Functions CLI basic Java Maven project template.</Description>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup>
    <Content Include="content/**" Pack="true" PackagePath="content/%(RecursiveDir)%(Filename)%(Extension)" />
    <Content Include="$(RepoRoot)LICENSE" Pack="true" PackagePath="/" />
    <Content Include="README.md" Pack="true" PackagePath="/" />
    <Content Include="../Templates/pom.xml;../Templates/local.settings.json" Pack="true" PackagePath="content/project/" />
    <Content Include="../Templates/Function.java" Pack="true" PackagePath="content/project/src/main/java/com/function/" />
  </ItemGroup>
  <Target Name="StageNativeIgnoreFiles" BeforeTargets="_GetPackageFiles">
    <Copy SourceFiles="../Templates/funcignore;../Templates/gitignore"
      DestinationFiles="$(IntermediateOutputPath)native/.funcignore;$(IntermediateOutputPath)native/.gitignore" />
    <ItemGroup>
      <Content Include="$(IntermediateOutputPath)native/.funcignore;$(IntermediateOutputPath)native/.gitignore"
        Pack="true" PackagePath="content/project/" />
    </ItemGroup>
  </Target>
  <Target Name="WriteJavaProjectProvenance" BeforeTargets="_GetPackageFiles">
    <ItemGroup>
      <_JavaProjectSource Include="content/project/.template.config/template.json" PackageSourcePath="content/project/.template.config/template.json" />
      <_JavaProjectSource Include="content/project/.template.config/func.host.json" PackageSourcePath="content/project/.template.config/func.host.json" />
      <_JavaProjectSource Include="content/project/host.json" PackageSourcePath="content/project/host.json" />
      <_JavaProjectSource Include="../Templates/pom.xml" PackageSourcePath="content/project/pom.xml" />
      <_JavaProjectSource Include="../Templates/Function.java" PackageSourcePath="content/project/src/main/java/com/function/Function.java" />
      <_JavaProjectSource Include="../Templates/local.settings.json" PackageSourcePath="content/project/local.settings.json" />
      <_JavaProjectSource Include="../Templates/funcignore" PackageSourcePath="content/project/.funcignore" />
      <_JavaProjectSource Include="../Templates/gitignore" PackageSourcePath="content/project/.gitignore" />
    </ItemGroup>
    <GetFileHash Files="@(_JavaProjectSource)" Algorithm="SHA256">
      <Output TaskParameter="Items" ItemName="_HashedJavaProjectSource" />
    </GetFileHash>
    <PropertyGroup>
      <_JavaProjectSourceJson>@(_HashedJavaProjectSource->'{ &quot;path&quot;: &quot;%(PackageSourcePath)&quot;, &quot;sha256&quot;: &quot;%(FileHash)&quot; }', ',')</_JavaProjectSourceJson>
    </PropertyGroup>
    <WriteLinesToFile File="$(IntermediateOutputPath)java-project-provenance.json" Overwrite="true" Encoding="UTF-8"
      Lines="{ &quot;schemaVersion&quot;: 1, &quot;packageId&quot;: &quot;$(PackageId)&quot;, &quot;packageVersion&quot;: &quot;$(PackageVersion)&quot;, &quot;identity&quot;: &quot;Azure.Functions.Java.Basic&quot;, &quot;stack&quot;: &quot;java&quot;, &quot;language&quot;: &quot;Java&quot;, &quot;sources&quot;: [$(_JavaProjectSourceJson)] }" />
    <ItemGroup>
      <Content Include="$(IntermediateOutputPath)java-project-provenance.json" Pack="true" PackagePath="provenance/java/project.json" />
    </ItemGroup>
  </Target>
</Project>
