<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <Title>.NET</Title>
    <Description>Azure Functions CLI tooling for .NET (C#, F#) projects.</Description>
    <PackAsWorkload>true</PackAsWorkload>
    <WorkloadKind>workload</WorkloadKind>
    <StackIdentifier>dotnet</StackIdentifier>
    <WorkerRuntime>dotnet-isolated</WorkerRuntime>
    <WorkloadTemplateRoot>content/templates</WorkloadTemplateRoot>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Azure.Functions.Cli.Workloads.DotNet.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="$(SrcRoot)Abstractions/Abstractions.csproj" />
    <ProjectReference Include="$(SrcRoot)Workloads/Templates/DotNet/Workloads.Templates.DotNet.csproj"
                      ReferenceOutputAssembly="false"
                      TargetPathPrefix="$(WorkloadTemplateRoot)"
                      Pack="true" />
  </ItemGroup>

</Project>
