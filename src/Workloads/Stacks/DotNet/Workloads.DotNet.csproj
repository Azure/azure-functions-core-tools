<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Title>.NET Stack</Title>
    <Description>Azure Functions CLI tooling for .NET (C#, F#) projects.</Description>
    <PackAsWorkload>true</PackAsWorkload>
    <WorkloadKind>workload</WorkloadKind>
    <WorkloadAlias>dotnet</WorkloadAlias>
    <NoDefaultExcludes>true</NoDefaultExcludes>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Azure.Functions.Cli.Workloads.DotNet.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="$(SrcRoot)Abstractions/Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageDownload Include="Microsoft.Azure.Functions.Worker.ProjectTemplates" Version="[4.0.5708]" />
    <PackageDownload Include="Microsoft.Azure.Functions.Worker.ItemTemplates" Version="[4.0.5708]" />
    <None Include="$(NuGetPackageRoot)/microsoft.azure.functions.worker.projecttemplates/4.0.5708/microsoft.azure.functions.worker.projecttemplates.4.0.5708.nupkg"
          Link="templates/project.nupkg" CopyToOutputDirectory="PreserveNewest" Pack="true" PackagePath="tools/any/templates/" />
    <None Include="$(NuGetPackageRoot)/microsoft.azure.functions.worker.itemtemplates/4.0.5708/microsoft.azure.functions.worker.itemtemplates.4.0.5708.nupkg"
          Link="templates/item.nupkg" CopyToOutputDirectory="PreserveNewest" Pack="true" PackagePath="tools/any/templates/" />
  </ItemGroup>

</Project>
