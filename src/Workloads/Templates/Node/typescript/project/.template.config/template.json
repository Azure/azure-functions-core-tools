{
  "$schema": "http://json.schemastore.org/template",
  "author": "Microsoft",
  "classifications": [ "Azure Functions", "Cloud" ],
  "identity": "Azure.Functions.Cli.Node.Project.TypeScript",
  "groupIdentity": "Azure.Functions.Cli.Node.Project",
  "name": "Azure Functions TypeScript project",
  "description": "A Node.js Azure Functions project using the v4 programming model.",
  "shortName": "func-node",
  "tags": {
    "language": "TypeScript",
    "stack": "node",
    "type": "project"
  },
  "preferNameDirectory": true,
  "symbols": {
    "HostIdentifier": {
      "type": "bind",
      "binding": "host:HostIdentifier"
    },
    "NoHttp": {
      "type": "parameter",
      "datatype": "bool",
      "defaultValue": "false",
      "description": "Omit the sample HTTP function."
    },
    "NoBundle": {
      "type": "parameter",
      "datatype": "bool",
      "defaultValue": "false",
      "description": "Omit the extension bundle from host.json."
    },
    "BundlesChannel": {
      "type": "parameter",
      "datatype": "choice",
      "defaultValue": "Stable",
      "description": "The extension bundle release channel.",
      "choices": [
        { "choice": "Stable", "description": "Generally available extension bundle." },
        { "choice": "Preview", "description": "Preview extension bundle." },
        { "choice": "Experimental", "description": "Experimental extension bundle." }
      ]
    },
    "BundleId": {
      "type": "generated",
      "generator": "switch",
      "replaces": "Microsoft.Azure.Functions.ExtensionBundle",
      "parameters": {
        "evaluator": "C++",
        "datatype": "string",
        "cases": [
          { "condition": "(BundlesChannel == \"Preview\")", "value": "Microsoft.Azure.Functions.ExtensionBundle.Preview" },
          { "condition": "(BundlesChannel == \"Experimental\")", "value": "Microsoft.Azure.Functions.ExtensionBundle.Experimental" },
          { "condition": "", "value": "Microsoft.Azure.Functions.ExtensionBundle" }
        ]
      }
    },
    "LowerName": {
      "type": "generated",
      "generator": "casing",
      "parameters": {
        "source": "name",
        "toLower": true
      }
    },
    "PackageName": {
      "type": "generated",
      "generator": "regex",
      "replaces": "functions-project",
      "parameters": {
        "source": "LowerName",
        "steps": [
          { "regex": "[^a-z0-9._-]+", "replacement": "-" }
        ]
      }
    }
  },
  "sources": [
    {
      "source": "./",
      "target": "./",
      "modifiers": [
        {
          "condition": "NoHttp",
          "exclude": [ "src/functions/HelloWorld.ts" ]
        }
      ]
    }
  ],
  "primaryOutputs": [
    { "path": "package.json" }
  ],
  "postActions": [
    {
      "condition": "(HostIdentifier == \"func\")",
      "description": "Install npm packages required by this project.",
      "actionId": "210D431B-A78B-4D2F-B762-4ED3E3EA9025",
      "continueOnError": false,
      "args": {
        "files": [ "package.json" ]
      },
      "manualInstructions": [
        { "text": "Run 'npm install' in the generated project directory." }
      ]
    }
  ]
}
