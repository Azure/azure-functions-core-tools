{
  "$schema": "http://json.schemastore.org/template",
  "author": "Microsoft",
  "classifications": [ "Azure Functions", "HTTP" ],
  "identity": "Azure.Functions.Cli.PowerShell.HttpTrigger",
  "name": "Azure Functions HTTP trigger (PowerShell)",
  "description": "An HTTP trigger using PowerShell.",
  "shortName": "httptrigger",
  "defaultName": "HttpFunction",
  "tags": {
    "language": "PowerShell",
    "stack": "powershell",
    "type": "item"
  },
  "sourceName": "HttpFunction",
  "symbols": {
    "AuthLevel": {
      "type": "parameter",
      "datatype": "choice",
      "defaultValue": "function",
      "description": "The authorization level for the HTTP trigger.",
      "choices": [
        { "choice": "function", "description": "Require a function key." },
        { "choice": "anonymous", "description": "Allow anonymous requests." },
        { "choice": "admin", "description": "Require the host master key." }
      ]
    },
    "AuthLevelExpression": {
      "type": "generated",
      "generator": "regex",
      "replaces": "\"authLevel\": \"function\"",
      "parameters": {
        "source": "AuthLevel",
        "steps": [
          { "regex": "^(.*)$", "replacement": "\"authLevel\": \"$1\"" }
        ]
      }
    }
  },
  "sources": [
    {
      "source": "./",
      "target": "./",
      "rename": {
        "HttpFunction/run.ps1.txt": "HttpFunction/run.ps1"
      }
    }
  ],
  "primaryOutputs": [
    { "path": "HttpFunction/run.ps1" },
    { "path": "HttpFunction/function.json" }
  ]
}
