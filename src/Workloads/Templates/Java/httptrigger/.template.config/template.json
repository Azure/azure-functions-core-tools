{
  "$schema": "http://json.schemastore.org/template",
  "author": "Microsoft",
  "classifications": [ "Azure Functions", "HTTP" ],
  "identity": "Azure.Functions.Cli.Java.HttpTrigger",
  "name": "Azure Functions HTTP trigger (Java)",
  "description": "An HTTP trigger using the Java worker SDK.",
  "shortName": "httptrigger",
  "defaultName": "HttpFunction",
  "tags": {
    "language": "Java",
    "stack": "java",
    "type": "item"
  },
  "symbols": {
    "PackageName": {
      "type": "parameter",
      "datatype": "string",
      "defaultValue": "com.function",
      "description": "The Java package for the generated function."
    },
    "AuthLevel": {
      "type": "parameter",
      "datatype": "choice",
      "defaultValue": "function",
      "description": "The authorization level for the HTTP trigger.",
      "choices": [
        { "choice": "function", "description": "Require a function key." },
        { "choice": "anonymous", "description": "Allow anonymous requests." },
        { "choice": "admin", "description": "Require the host master key." }
      ]
    },
    "UpperAuthLevel": {
      "type": "generated",
      "generator": "casing",
      "parameters": {
        "source": "AuthLevel",
        "toLower": false
      }
    },
    "AuthLevelExpression": {
      "type": "generated",
      "generator": "regex",
      "replaces": "AuthorizationLevel.FUNCTION",
      "parameters": {
        "source": "UpperAuthLevel",
        "steps": [
          { "regex": "^(.*)$", "replacement": "AuthorizationLevel.$1" }
        ]
      }
    },
    "NameWords": {
      "type": "generated",
      "generator": "regex",
      "parameters": {
        "source": "name",
        "steps": [
          { "regex": "([A-Z])([A-Z][a-z])", "replacement": "$1 $2" },
          { "regex": "([a-z0-9])([A-Z])", "replacement": "$1 $2" },
          { "regex": "[^a-zA-Z0-9]+", "replacement": " " }
        ]
      }
    },
    "TitleName": {
      "type": "derived",
      "valueSource": "NameWords",
      "valueTransform": "titleName"
    },
    "FunctionName": {
      "type": "generated",
      "generator": "regex",
      "replaces": "TemplateFunctionName",
      "parameters": {
        "source": "TitleName",
        "steps": [
          { "regex": "\\u0130", "replacement": "I" },
          { "regex": "\\u0131", "replacement": "i" },
          { "regex": "[^a-zA-Z0-9]", "replacement": "" },
          { "regex": "^[^a-zA-Z]", "replacement": "Function$&" },
          { "regex": "^(.{128}).*$", "replacement": "$1" },
          { "regex": "(?i)^(host|lib|con|prn|aux|nul|com[1-9]|lpt[1-9])$", "replacement": "Function$&" },
          { "regex": "^$", "replacement": "Function" }
        ]
      }
    },
    "ClassName": {
      "type": "generated",
      "generator": "regex",
      "replaces": "TemplateClassName",
      "fileRename": "TemplateClassName",
      "parameters": {
        "source": "FunctionName",
        "steps": [
          { "regex": "^", "replacement": "Function" }
        ]
      }
    },
    "NormalizedPackageName": {
      "type": "generated",
      "generator": "regex",
      "replaces": "com.function",
      "parameters": {
        "source": "PackageName",
        "steps": [
          { "regex": "[^a-zA-Z0-9_.]", "replacement": "_" },
          { "regex": "\\.+", "replacement": "." },
          { "regex": "^\\.|\\.$", "replacement": "" },
          { "regex": "(^|\\.)(?=[0-9])", "replacement": "$1pkg" },
          { "regex": "(?<![a-zA-Z0-9_])(abstract|assert|boolean|break|byte|case|catch|char|class|const|continue|default|do|double|else|enum|extends|final|finally|float|for|goto|if|implements|import|instanceof|int|interface|long|native|new|package|private|protected|public|return|short|static|strictfp|super|switch|synchronized|this|throw|throws|transient|try|void|volatile|while|true|false|null|_)(?![a-zA-Z0-9_])", "replacement": "pkg_$&" },
          { "regex": "(?i)(?<![a-zA-Z0-9_])(con|prn|aux|nul|com[1-9]|lpt[1-9])(?![a-zA-Z0-9_])", "replacement": "pkg_$&" },
          { "regex": "^java(?=\\.|$)", "replacement": "pkg_java" },
          { "regex": "^$", "replacement": "com.function" }
        ]
      }
    },
    "PackagePath": {
      "type": "generated",
      "generator": "regex",
      "fileRename": "TemplatePackagePath",
      "parameters": {
        "source": "NormalizedPackageName",
        "steps": [
          { "regex": "\\.", "replacement": "/" }
        ]
      }
    }
  },
  "forms": {
    "titleName": { "identifier": "titleCase" }
  },
  "primaryOutputs": [
    { "path": "src/main/java/TemplatePackagePath/TemplateClassName.java" }
  ]
}
