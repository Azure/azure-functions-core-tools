{
  "$schema": "http://json.schemastore.org/template",
  "author": "Microsoft",
  "classifications": [ "Azure Functions", "Cloud" ],
  "identity": "Azure.Functions.Cli.DotNet.Project.CSharp",
  "name": "Azure Functions C# project",
  "description": "An isolated-worker Azure Functions project with optional HTTP and OpenTelemetry support.",
  "shortName": "func-dotnet",
  "tags": {
    "language": "C#",
    "stack": "dotnet",
    "type": "project"
  },
  "sourceName": "FunctionsProject",
  "preferNameDirectory": true,
  "symbols": {
    "Framework": {
      "type": "parameter",
      "datatype": "choice",
      "description": "The target framework for the project.",
      "defaultValue": "net10.0",
      "replaces": "net10.0",
      "choices": [
        { "choice": "net10.0", "description": ".NET 10" },
        { "choice": "net11.0", "description": ".NET 11" }
      ]
    },
    "NoHttp": {
      "type": "parameter",
      "datatype": "bool",
      "defaultValue": "false",
      "description": "Omit the HTTP function and ASP.NET Core integration."
    },
    "NoTelemetry": {
      "type": "parameter",
      "datatype": "bool",
      "defaultValue": "false",
      "description": "Omit OpenTelemetry and Azure Monitor export."
    }
  },
  "sources": [
    {
      "source": "./",
      "target": "./",
      "modifiers": [
        {
          "condition": "NoHttp",
          "exclude": [ "HelloWorld.cs" ]
        }
      ]
    }
  ],
  "primaryOutputs": [
    { "path": "FunctionsProject.csproj" }
  ],
  "postActions": [
    {
      "description": "Restore NuGet packages required by this project.",
      "actionId": "210D431B-A78B-4D2F-B762-4ED3E3EA9025",
      "continueOnError": false,
      "args": {
        "files": [ "*.csproj" ]
      },
      "manualInstructions": [
        { "text": "Run 'dotnet restore' in the generated project directory." }
      ]
    }
  ]
}
