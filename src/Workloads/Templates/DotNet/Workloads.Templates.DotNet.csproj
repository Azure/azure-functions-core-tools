<Project Sdk="Microsoft.Build.NoTargets">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <EnableDefaultItems>false</EnableDefaultItems>
  </PropertyGroup>

  <ItemGroup>
    <None Include="**" Exclude="bin/**;obj/**;$(MSBuildProjectFile)"
          TargetPath="content/templates/%(Identity)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>