<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="$(EngBuildRoot)Telemetry.props" />

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeIdentifiers>$(_CliRuntimeIdentifiers)</RuntimeIdentifiers>
    <AssemblyName>func</AssemblyName>
    <RootNamespace>$(TopLevelNamespace)</RootNamespace>
    <InvariantGlobalization>false</InvariantGlobalization>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IsPackable>false</IsPackable>
    <IsPublishable>true</IsPublishable>
    <EnableDemoProject>true</EnableDemoProject>
    <DefineConstants>$(DefineConstants);FUNC_HOST_DOTNET_TEMPLATES;FUNC_GO_TEMPLATE_HELPERS;FUNC_POWERSHELL_TEMPLATE_HELPERS;FUNC_PYTHON_TEMPLATE_HELPERS</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Azure.Functions.Cli.Tests" />
    <InternalsVisibleTo Include="Azure.Functions.Cli.Templates.Tests.StoreProcess" />
    <InternalsVisibleTo Include="Azure.Functions.Cli.Workloads.Tests.OperationProcess" />
    <!-- Required for NSubstitute (Castle DynamicProxy) to mock internal interfaces. -->
    <InternalsVisibleTo Include="DynamicProxyGenAssembly2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Abstractions/Abstractions.csproj" />
    <ProjectReference Include="../Templates.V2/Templates.V2.csproj" />
    <ProjectReference Include="../Templates.DotNet/Templates.DotNet.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="../Workloads/Stacks/Node/NodeNpmInstaller.cs" Link="Templates/Node/NodeNpmInstaller.cs" />
    <Compile Include="../Workloads/Stacks/DotNet/Templates/DotNetProjectFileSelection.cs" Link="Templates/DotNet/Shared/DotNetProjectFileSelection.cs" />
    <Compile Include="../Workloads/Stacks/DotNet/Templates/DotNetTemplateFrameworks.cs" Link="Templates/DotNet/Shared/DotNetTemplateFrameworks.cs" />
    <Compile Include="../Workloads/Stacks/DotNet/Templates/DotNetTemplateProjectPreparation.cs" Link="Templates/DotNet/Shared/DotNetTemplateProjectPreparation.cs" />
    <Compile Include="../Workloads/Stacks/DotNet/Templates/DotNetTemplateDependencyExecutor.cs" Link="Templates/DotNet/Shared/DotNetTemplateDependencyExecutor.cs" />
    <Compile Include="../Workloads/Stacks/DotNet/Templates/DotNetTemplatePackageReference.cs" Link="Templates/DotNet/Shared/DotNetTemplatePackageReference.cs" />
    <Compile Include="../Workloads/Stacks/DotNet/Templates/FSharpCompileUpdater.cs" Link="Templates/DotNet/Shared/FSharpCompileUpdater.cs" />
    <Compile Include="../Workloads/Stacks/DotNet/Templates/FSharpProjectFiles.cs" Link="Templates/DotNet/Shared/FSharpProjectFiles.cs" />
    <Compile Include="../Workloads/Stacks/DotNet/DotNetCli/IDotnetCliRunner.cs" Link="Templates/DotNet/Shared/IDotnetCliRunner.cs" />
    <Compile Include="../Workloads/Stacks/DotNet/DotNetCli/IDotnetPathResolver.cs" Link="Templates/DotNet/Shared/IDotnetPathResolver.cs" />
    <Compile Include="../Workloads/Stacks/DotNet/DotNetCli/DotnetCliRunner.cs" Link="Templates/DotNet/Shared/DotnetCliRunner.cs" />
    <Compile Include="../Workloads/Stacks/DotNet/DotNetCli/DotnetPathResolver.cs" Link="Templates/DotNet/Shared/DotnetPathResolver.cs" />
    <Compile Include="../Workloads/Stacks/DotNet/DotNetCli/DotnetCliException.cs" Link="Templates/DotNet/Shared/DotnetCliException.cs" />
    <Compile Include="../Workloads/Stacks/Go/GoProjectPreparation.cs" Link="Templates/Go/GoProjectPreparation.cs" />
    <Compile Include="../Workloads/Stacks/PowerShell/PowerShellProjectPreparation.cs" Link="Templates/PowerShell/PowerShellProjectPreparation.cs" />
    <EmbeddedResource Include="../Workloads/Stacks/PowerShell/Templates/requirements.psd1" LogicalName="func.Templates.requirements.psd1" />
    <Compile Include="../Workloads/Stacks/Python/IPythonTemplateAppendExecutor.cs" Link="Templates/Python/Shared/IPythonTemplateAppendExecutor.cs" />
    <Compile Include="../Workloads/Stacks/Python/PythonTemplateAppendExecutor.cs" Link="Templates/Python/Shared/PythonTemplateAppendExecutor.cs" />
    <Compile Include="../Workloads/Stacks/Python/PythonFunctionNameGuard.cs" Link="Templates/Python/Shared/PythonFunctionNameGuard.cs" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Profiles/BuiltInProfiles.json" LogicalName="Azure.Functions.Cli.Profiles.BuiltInProfiles.json" />
    <EmbeddedResource Include="Templates/Acquisition/BasicCompanions.json" LogicalName="Azure.Functions.Cli.Templates.Acquisition.BasicCompanions.json" />
    <EmbeddedResource Include="../Workloads/Stacks/Node/NativeTemplates/qualified-sources.json"
      LogicalName="Azure.Functions.Cli.Templates.Node.qualified-sources.json" />
    <EmbeddedResource Include="../Workloads/Stacks/DotNet/NativeTemplates/upstream-configurations.json"
      Link="Templates/DotNet/upstream-configurations.json" LogicalName="Azure.Functions.Cli.Templates.DotNet.upstream-configurations.json" />
    <EmbeddedResource Include="../Workloads/Stacks/DotNet/NativeTemplates/auxiliary-identities.json"
      Link="Templates/DotNet/auxiliary-identities.json" LogicalName="Azure.Functions.Cli.Templates.DotNet.auxiliary-identities.json" />
    <EmbeddedResource Include="../Workloads/Stacks/DotNet/NativeTemplates/binding-literals.json"
      LogicalName="Azure.Functions.Cli.Templates.DotNet.binding-literals.json" />
    <EmbeddedResource Include="../Workloads/Stacks/DotNet/NativeTemplates/binding-literals-qualified.json"
      LogicalName="Azure.Functions.Cli.Templates.DotNet.binding-literals-qualified.json" />
    <EmbeddedResource Include="../Workloads/Stacks/DotNet/NativeTemplates/fsharp-control-sources.json"
      LogicalName="Azure.Functions.Cli.Templates.DotNet.fsharp-control-sources.json" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="NuGet.Packaging" />
    <PackageReference Include="NuGet.Protocol" />
    <PackageReference Include="Microsoft.TemplateEngine.Abstractions" />
    <PackageReference Include="Microsoft.TemplateEngine.Edge" />
    <PackageReference Include="Microsoft.TemplateEngine.Orchestrator.RunnableProjects" />
    <PackageReference Include="System.CommandLine" />
    <PackageReference Include="Spectre.Console" />
    <PackageReference Include="OpenTelemetry" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" />
    <PackageReference Include="Azure.Monitor.OpenTelemetry.Exporter" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.Extensions.Http" />
    <PackageReference Include="Microsoft.Extensions.FileSystemGlobbing" />
    <PackageReference Include="Microsoft.Extensions.Options.DataAnnotations" />
    <PackageReference Include="NuGet.Versioning" />
    <PackageReference Include="Semver" />
  </ItemGroup>

  <!--
    Verifies that a single-file publish actually produced a single file (plus an
    optional .pdb). Guards against silent regressions when a new dependency or
    content item starts emitting loose files alongside the apphost, which would
    break "loose executable" distribution and macOS signing assumptions.
  -->
  <Target Name="VerifySingleFilePublish"
          AfterTargets="Publish"
          Condition="'$(IsPublishable)' == 'true' AND '$(PublishSingleFile)' == 'true'">
    <ItemGroup>
      <_PublishedFile Include="$(PublishDir)*" />
      <_AllowedPublishedFile Include="$(PublishDir)$(AssemblyName)" />
      <_AllowedPublishedFile Include="$(PublishDir)$(AssemblyName).exe" />
      <_AllowedPublishedFile Include="$(PublishDir)*.pdb" />
      <_UnexpectedPublishedFile Include="@(_PublishedFile)" Exclude="@(_AllowedPublishedFile)" />
    </ItemGroup>

    <Error Condition="'@(_UnexpectedPublishedFile)' != ''"
           Text="Single-file publish for '$(RuntimeIdentifier)' produced unexpected files in '$(PublishDir)': @(_UnexpectedPublishedFile->'%(Filename)%(Extension)', ', '). Only '$(AssemblyName)', '$(AssemblyName).exe', and '$(AssemblyName).pdb' are allowed. A new dependency or content item likely broke the single-file assumption; ensure 'IncludeNativeLibrariesForSelfExtract' covers it or remove the extra payload." />
  </Target>

</Project>
